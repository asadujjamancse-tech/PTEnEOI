### Copy this file to .env and add only the services you want to enable.

# Existing Anthropic scoring proxy
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI essay feedback and tutor chat
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Supabase cloud sync/auth config
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe subscriptions
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PRICE_PREMIUM=price_replace_me
APP_URL=http://localhost:5173
